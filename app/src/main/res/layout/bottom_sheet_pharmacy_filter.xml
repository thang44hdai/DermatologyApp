<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drag_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Bộ lọc"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dragHandle" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="Đặt lại"
            android:textColor="@color/primary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle" />

        <!-- Distance Filter -->
        <TextView
            android:id="@+id/tvDistanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Khoảng cách"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <RadioGroup
            android:id="@+id/radioGroupDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvDistanceLabel">

            <RadioButton
                android:id="@+id/radioAll"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tất cả"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio1km"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Dưới 1 km"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio3km"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Dưới 3 km"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio5km"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Dưới 5 km"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio10km"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Dưới 10 km"
                android:textColor="#333333"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- Rating Filter -->
        <TextView
            android:id="@+id/tvRatingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Đánh giá"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radioGroupDistance" />

        <RadioGroup
            android:id="@+id/radioGroupRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvRatingLabel">

            <RadioButton
                android:id="@+id/radioAllRating"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tất cả"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio3star"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Từ 3 sao trở lên ⭐⭐⭐"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio4star"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Từ 4 sao trở lên ⭐⭐⭐⭐"
                android:textColor="#333333"
                android:textSize="15sp" />

            <RadioButton
                android:id="@+id/radio45star"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_radio_button"
                android:buttonTint="@color/primary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Từ 4.5 sao trở lên ⭐⭐⭐⭐⭐"
                android:textColor="#333333"
                android:textSize="15sp" />
        </RadioGroup>

        <!-- Open Time Filter -->
        <TextView
            android:id="@+id/tvOpenTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Thời gian mở cửa"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/radioGroupRating" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch24h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:checked="false"
            android:text="Chỉ hiển thị nhà thuốc mở 24/7"
            android:textColor="#333333"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvOpenTimeLabel"
            app:thumbTint="@color/primary"
            app:trackTint="@color/switch_track_tint" />

        <!-- Apply Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_btn_filter"
            android:text="Áp dụng"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/switch24h" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
