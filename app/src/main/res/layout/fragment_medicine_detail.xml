<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <!-- Product Image -->
            <ImageView
                android:id="@+id/img_product"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/white"
                android:contentDescription="product image"
                android:scaleType="centerInside"
                app:layout_constraintHeight_percent="0.5"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/bg_take" />

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="20dp"
                android:src="@drawable/ic_arrow_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Product Details Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_product_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-50dp"
                android:background="@drawable/bg_medicine_detail"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/img_product">

                <!-- Product Title -->
                <TextView
                    android:id="@+id/tv_product_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="Gel Chấm Giảm Mụn Cấp Tốc Murad Rapid Relief Acne Spot Treatment 15ml"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Gel Chấm Giảm Mụn Cấp Tốc Murad Rapid Relief Acne Spot Treatment 15ml" />

                <!-- Description Header -->
                <TextView
                    android:id="@+id/tv_description_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mô Tả"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_product_title" />

                <!-- Description Text -->
                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Là Gel Chấm Mụn Đến Từ Thương Hiệu Murad. Sản Phẩm Được Điều Chế Từ Công Thức Chuyên Biệt, Với Sức Mạnh Tối Đa Giúp Ức Chế Tình Trạng Sưng Viêm, Tấy Đỏ Của Nốt Mụn Trong Vòng 4 Giờ. 97% Người Dùng Đồng Ý Tình Trạng Mụn Của Họ Đã Cải Thiện Rõ Rệt Chỉ Sau 1 Ngày Sử Dụng."
                    android:textColor="@color/gray_neutral_4"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_description_header"
                    tools:text="Là Gel Chấm Mụn Đến Từ Thương Hiệu Murad. Sản Phẩm Được Điều Chế Từ Công Thức Chuyên Biệt, Với Sức Mạnh Tối Đa Giúp Ức Chế Tình Trạng Sưng Viêm, Tấy Đỏ Của Nốt Mụn Trong Vòng 4 Giờ. 97% Người Dùng Đồng Ý Tình Trạng Mụn Của Họ Đã Cải Thiện Rõ Rệt Chỉ Sau 1 Ngày Sử Dụng." />

                <!-- Price -->
                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="₫776,000"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_description"
                    tools:text="₫776,000" />

                <!-- Find Pharmacy Button -->
                <LinearLayout
                    android:id="@+id/btn_find_pharmacy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_login"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_price">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="link"
                        android:src="@drawable/ic_link"
                        android:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Tìm hiệu thuốc gần nhất"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>


